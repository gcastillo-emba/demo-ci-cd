# Variables del POC "Asuntos & Horas". TODOS los valores son ficticios y solo sirven para demo local.
# docker compose ya usa estos mismos valores por defecto; copiar a .env solo si se quiere cambiar
# alguno (.env está en .gitignore y nunca se versiona).

# --- Imágenes -------------------------------------------------------------------------------
# Tag de las imágenes ghcr.io/gcastillo-emba/demo-ci-cd-{backend,frontend}.
# docker-compose.yml usa "local" (build); docker-compose.demo.yml usa "latest" (o vX.Y.Z / sha-xxxxxxx).
TAG=local

# --- PostgreSQL (solo demo) -----------------------------------------------------------------
POSTGRES_DB=asuntos
POSTGRES_USER=asuntos
POSTGRES_PASSWORD=asuntos-dev
# Puerto publicado en el host (scripts/dev.mjs conecta el backend local a localhost:5432).
POSTGRES_PORT=5432

# --- Backend --------------------------------------------------------------------------------
# Perfil "demo": carga el seed idempotente de usuarios de demo (db/seed/R__seed_demo_users.sql).
SPRING_PROFILES_ACTIVE=demo
BACKEND_PORT=8081
# Secreto HS256 para firmar los JWT (mínimo 32 bytes). Sin definir, el perfil demo usa su valor
# FALSO y público, definido en un único lugar: backend/src/main/resources/application-demo.yml.
# En cualquier entorno real se genera uno aleatorio (p. ej. `openssl rand -base64 48`) y se
# inyecta como secreto; fuera del perfil demo no hay valor por defecto (el backend no arranca).
# APP_JWT_SECRET=

# --- Frontend -------------------------------------------------------------------------------
FRONTEND_PORT=8080

# --- E2E (scripts/e2e.mjs) ------------------------------------------------------------------
BASE_URL=http://localhost:8080

# --- Asistente de descripciones (C4; aún no implementado) -----------------------------------
# "fake" (por defecto, sin red) o "anthropic". La clave real NUNCA va en este archivo: se
# configura como secreto ANTHROPIC_API_KEY en GitHub (evals-real.yml / claude-review.yml).
APP_ASSISTANT_PROVIDER=fake

# --- Usuarios de demo (perfil demo; datos 100 % sintéticos) ---------------------------------
# socia@asuntos.test    "Socia Demo"   PARTNER
# abogado1@asuntos.test "Abogado Uno"  LAWYER
# abogado2@asuntos.test "Abogada Dos"  LAWYER
# abogado3@asuntos.test "Abogado Tres" LAWYER
# Contraseña de todos (solo demo): Demo2026!
