{
  "name": "asuntos-horas",
  "private": true,
  "version": "0.0.0",
  "description": "POC Asuntos & Horas — MADA-MB",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "frontend",
    "e2e"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "api:lint": "redocly lint api/openapi.yaml --config api/redocly.yaml",
    "api:generate": "node scripts/api-client.mjs",
    "api:check": "node scripts/api-client.mjs --check",
    "backend:verify": "node scripts/mvn.mjs -B -ntp verify",
    "backend:test:fast": "node scripts/mvn.mjs -B -ntp -DskipITs verify",
    "frontend:lint": "npm run lint -w frontend",
    "frontend:typecheck": "npm run typecheck -w frontend",
    "frontend:test": "npm run test -w frontend",
    "frontend:build": "npm run build -w frontend",
    "evals": "node scripts/evals.mjs",
    "e2e": "node scripts/e2e.mjs",
    "demo:check": "node scripts/demo-check.mjs",
    "hooks:test": "node --test \".claude/hooks/test/*.test.mjs\"",
    "scripts:test": "node --test \"scripts/test/*.test.mjs\"",
    "format:check": "prettier --check \"**/*.{md,json,yml,yaml,mjs}\"",
    "gate": "node scripts/gate.mjs",
    "bitacora:resumen": "node scripts/claude-resumen-bitacora.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.16.0",
    "@redocly/cli": "2.75.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10"
  }
}
